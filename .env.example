# Copy to .env (git-ignored) and fill in real values. Never commit .env.
# 12-factor: all config comes from the environment; nothing is hard-coded.

# --- Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=homeme

# --- Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change-me

# --- LLM / embeddings (not used until the first agent)
OPENAI_API_KEY=

# --- Tracing (not used until the first agent)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=homeme
